{
  "name": "zh-ui",
  "auther": "zh",
  "private": false,
  "version": "1.0.6",
  "description": "这是一个模仿element ui写的ui组件。用以练手和学习。",
  "keyword": "typescript tailwindcss ui element",
  "files": [
    "ZHUI"
  ],
  "main": "./ZHUI/zh-ui.es.js",
  "module": "./ZHUI/zh-ui.es.js",
  "repository": "https://gitee.com/lixindekongjian/zh-ui.git",
  "scripts": {
    "dev": "vite --host --mode development --config ./config/dev.config.ts",
    "build:doc": "vue-tsc --noEmit --skipLibCheck && vite build --mode production --config ./config/prod.doc.config.ts && node ./config/copyDocs.js && shx cp docs/index.html docs/404.html",
    "build:com": "npm run generate-resolver && vue-tsc --noEmit --skipLibCheck && vite build --mode production --config ./config/prod.com.config.ts && node ./config/copyDist.js",
    "preview": "vite preview",
    "build:types": "vue-tsc --declaration --emitDeclarationOnly --outDir ZHUI/dist",
    "generate-resolver": "tsx scripts/generate-resolver.ts",
    "publish": "node ./config/publicPush.js"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@bundled-es-modules/pdfjs-dist": "^3.6.172-alpha.1",
