    "vite-plugin-dts": "^5.0.2",
    "vite-plugin-md": "^0.11.6",
    "vite-plugin-mockit": "^1.0.1",
    "vite-plugin-style-import": "^0.7.3",
    "vue-jest": "^5.0.0-alpha.10",
    "vue-tsc": "^3.3.3"
  }
